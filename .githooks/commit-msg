#!/bin/sh
# 현재 worktree의 검사기를 실행한다. Python 경로에는 인자를 넣지 않는다.
set -eu

if [ "$#" -ne 1 ]; then
    printf '%s\n' '오류: 커밋 메시지 파일 한 개를 인자로 지정해야 합니다.' >&2
    exit 2
fi

python=${COMMIT_MESSAGE_PYTHON:-python3}
if ! command -v "$python" >/dev/null 2>&1; then
    printf '%s\n' '오류: Python을 찾을 수 없습니다. COMMIT_MESSAGE_PYTHON에 Python 3.11 이상 실행 파일을 지정하세요.' >&2
    exit 2
fi
"$python" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' || {
    printf '%s\n' '오류: Python 3.11 이상이 필요합니다.' >&2
    exit 2
}

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    printf '%s\n' '오류: 현재 체크아웃의 Git 저장소 루트를 찾을 수 없습니다.' >&2
    exit 2
}
checker="$root/scripts/check_commit_message.py"
if [ ! -f "$checker" ]; then
    printf '%s\n' '오류: 현재 체크아웃에 scripts/check_commit_message.py가 없습니다.' >&2
    exit 2
fi
exec "$python" "$checker" --git-context "$1"
